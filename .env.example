# Скопируй этот файл в .env и впиши свои значения. Файл .env не коммитится.
# Без ANTHROPIC_API_KEY сервер работает в демо-режиме (заглушка вместо LLM).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Необязательно: лимиты (значения по умолчанию)
# RATE_LIMIT_PER_MINUTE=60   запросов в минуту с одного IP
# DAILY_LLM_LIMIT=300        вызовов настоящего AI в сутки (защита баланса ключа)
