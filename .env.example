# Скопируй этот файл в .env и впиши свои значения. Файл .env не коммитится.
# Без ключа встроенный AI отключён (работает режим копирования туда и обратно).
# Достаточно ОДНОГО из двух вариантов.

# Вариант 1. Claude (платный)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Вариант 2. Любой сервис с OpenAI-совместимым API, в том числе бесплатный (Groq, Google Gemini, OpenRouter,
# локальные Ollama и LM Studio). Название модели берите со страницы «Models» сервиса.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=
# Необязательно: модель с поддержкой изображений. С ней AI получает закрашенное фото документа (страница
# «Sənəd qoruması», кнопка отправки AI); без неё уходит только текст документа с метками. Claude читает картинки сам.
# LLM_VISION_MODEL=

# Необязательно: секретный ключ журнала аудита (HMAC). Без него создаётся файл data/audit/audit.key.
# На публичном сервере задайте длинное случайное значение и храните его отдельно от журнала.
# AUDIT_KEY=

# Необязательно: закраска документов (requirements-vision.txt)
# OCR_THREADS=4          потоков OCR (на процессорах с десятками ядер большое число замедляет)
# REDACT_CONCURRENCY=2   сколько документов обрабатывать одновременно

# Необязательно: лимиты (значения по умолчанию)
# RATE_LIMIT_PER_MINUTE=60   запросов в минуту с одного IP
# DAILY_LLM_LIMIT=300        вызовов настоящего AI в сутки (защита баланса ключа)
