{
  "manifest_version": 3,
  "name": "SiftGuard — AI üçün məlumat filtri",
  "short_name": "SiftGuard",
  "version": "0.3.1",
  "description": "chatgpt.com-a yapışdırılan mətndəki şəxsi məlumatları (FİN, IBAN, kart, ad, ünvan...) maskalayır, əlavə olunan şəkil və PDF sənədlərdə isə məlumatları, üzü və imzanı qaralayır. Hamısı yerli SiftGuard serverində.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "SiftGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
